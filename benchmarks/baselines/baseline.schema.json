{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyexcel.rs/schemas/reviewed-performance-baseline-v2.json",
  "title": "EasyExcel reviewed performance baseline",
  "description": "Schema v2 supports two modes: approved baselines (approval+summaries required) and pending stubs (pending_generation=true, approval+summaries optional).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "profile",
    "spec_sha256",
    "source_git_shas",
    "candidate_report_sha256",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact": {"const": "easyexcel-reviewed-performance-baseline"},
    "profile": {"enum": ["nightly", "release"]},
    "pending_generation": {
      "type": "boolean",
      "description": "When true, this file is a stub placeholder awaiting a real benchmark run. The approval and summaries fields are omitted."
    },
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_git_shas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["java", "rust"],
      "properties": {
        "java": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "rust": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "candidate_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"const": "approved"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "summaries": {"type": "object", "minProperties": 1},
    "scenario_slots": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of scenario IDs that this baseline covers. Present in stubs to indicate expected coverage."
    }
  },
  "if": {
    "properties": {"pending_generation": {"const": true}}
  },
  "then": {
    "required": ["pending_generation"]
  },
  "else": {
    "required": ["approval", "summaries"]
  }
}
